# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only/Secret key for admin scripts (e.g. image upload script)
SUPABASE_SERVICE_ROLE_KEY=

# --- Inquiry email alerts (optional) -------------------------------
# Without these the inquiry inbox still works — threads are saved and both
# sides see them on the site; only the email nudge is skipped.
#
# resend.com → API Keys. Server-only: never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend, e.g.
#   MR.RIDER <inquiries@mrrider.lk>
# For a first test, Resend's sandbox sender works: MR.RIDER <onboarding@resend.dev>
RESEND_FROM=
# Where new inquiries and rider replies are announced. Used as the fallback
# whenever the per-language addresses below are blank.
INQUIRY_ADMIN_EMAIL=admin@mrrider.lk

# --- Inquiry routing by language -----------------------------------
# Riders choose Sinhala or English when they open an inquiry (migration 20).
# The club asked for Sinhala threads to reach Don; the English recipient is
# still to be confirmed. Fill either in and routing starts immediately —
# whatever is left blank falls back to INQUIRY_ADMIN_EMAIL above, so the
# inbox keeps working exactly as it does today until they are set.
INQUIRY_ADMIN_EMAIL_SI=
INQUIRY_ADMIN_EMAIL_EN=
# Public origin of the deployed site, e.g. https://mrrider.lk — used for the
# "open the thread" button in those emails. Deliberately NOT derived from the
# request: that resolves to the server's own bind address when self-hosting.
# Leave it blank and the emails simply go out without a link.
NEXT_PUBLIC_SITE_URL=

# --- WhatsApp (optional) -------------------------------------------
# After sending an inquiry the rider is offered a second way to carry on the
# conversation. Digits only or the usual +94 77 … formatting — both work, the
# app strips everything that is not a digit. A number left blank simply hides
# the WhatsApp button for that language; the thread on the site is always
# offered either way.
#
# NEXT_PUBLIC_ because the link is built in the browser. That is fine: a
# WhatsApp number the club wants customers to message is public by definition.
NEXT_PUBLIC_WHATSAPP_SI=
NEXT_PUBLIC_WHATSAPP_EN=
# Used for both when the two above are blank.
NEXT_PUBLIC_WHATSAPP=
